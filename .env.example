# Wishlist (Steam) job. ApiBaseUrl/TimeoutSeconds keep their defaults.
# MinHoursBetweenRuns gates the recovery pass of a host start against the job_runs log: a deploy, a crash
# loop or a local debug session inside this window skips the pass instead of replaying it. The daily slot
# at RunAtHour is never gated by it.
# Wishlist__Enabled=true
# Wishlist__RunAtHour=3
# Wishlist__JitterMinutes=10
# Wishlist__TimeZoneId=America/Mexico_City
# Wishlist__StartupDelaySeconds=60
# Wishlist__MaxRefreshesPerHour=1000
# Wishlist__MinHoursBetweenRuns=20
